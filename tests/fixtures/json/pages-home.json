              {
                "uuid": "ee1f4f8c-e176-4f27-b6d2-6c5c62c71601",
                "title": "Dolly Parton Essentials",
                "type": "EDITORIAL",
                "url": "https://tidal.com/browse/playlist/ee1f4f8c-e176-4f27-b6d2-6c5c62c71601",
                "image": "b28ee3d7-8013-4249-a5ab-c96a2929e650",
                "squareImage": "31737a05-259c-44d1-9d5f-417b69e1a3ef",
                "duration": 4676,
                "numberOfTracks": 25,
                "numberOfVideos": 0,
                "lastItemAddedAt": "2026-08-26T12:56:11.22Z",
                "promotedArtists": [
                  {
                    "id": 144,
                    "name": "Dolly Parton",
                    "type": "MAIN",
                    "picture": "d84254a1-cb21-4730-a4ee-c1bdaffd7db7",
                    "handle": null,
                    "userId": 10000001,
                    "contributionLinkUrl": null
                  }
                ],
                "creators": [],
                "description": "Dolly Parton (1946-2026) was one of the most popular and highly respected singers and songwriters in the history of Country music. She rose from a humble background to become not only an iconic music star but also a successful business entrepreneur. She is one of the most honored artists of all time, with a record breaking number of hit songs and countless awards. Dolly Parton passed away on August 25, 2026. She was 80 years old. (Photo: Rovi) "
              },
              {
                "uuid": "b54cbce6-5fe6-470a-ace6-84ccb7cd43e8",
                "title": "Tracks & Traces: Dolly Parton",
                "type": "EDITORIAL",
                "url": "https://tidal.com/browse/playlist/b54cbce6-5fe6-470a-ace6-84ccb7cd43e8",
                "image": "c3daf691-f8bb-46fe-a773-9e77e8cd077e",
                "squareImage": "6968e338-15c1-49ea-a940-f5373ec695f0",
                "duration": 10517,
                "numberOfTracks": 50,
                "numberOfVideos": 0,
                "lastItemAddedAt": "2026-08-25T18:45:20.951Z",
                "promotedArtists": [
                  {
                    "id": 27400,
                    "name": "Loretta Lynn",
                    "type": "MAIN",
                    "picture": "e85c3835-b023-4435-8255-2fda39e47a64",
                    "handle": null,
                    "userId": null,
                    "contributionLinkUrl": null
                  },
                  {
                    "id": 30546,
                    "name": "Jeannie C. Riley",
                    "type": "MAIN",
                    "picture": "3c5ac102-3180-4cdf-8e62-73a662a350fb",
                    "handle": null,
                    "userId": null,
                    "contributionLinkUrl": null
                  },
                  {
                    "id": 3557299,
                    "name": "Taylor Swift",
                    "type": "MAIN",
                    "picture": "acce3554-c0dd-428b-b39a-18a06897a7c3",
                    "handle": null,
                    "userId": null,
                    "contributionLinkUrl": null
                  },
                  {
                    "id": 28106,
                    "name": "Nancy Sinatra",
                    "type": "MAIN",
                    "picture": "3b0d9a97-7eea-4f5d-980e-3f086095c5d6",
                    "handle": null,
                    "userId": null,
                    "contributionLinkUrl": null
                  }
                ],
                "creators": [],
                "description": "With Tracks & Traces, we aim to expand the horizon around a given artist with related tracks and similar artists in order to present a deeper insight into their music. Dolly Parton has been a significant music force ever since she broke through the charts in the late 1960s. With her recognisable voice, gifted songwriter skills and strong identity she paved way for female singers in many genres over the years, and her journey from poverty to massive crossover success has served as inspiration to numerous artists. Parton moves flawlessly from bluegrass to countrypolitan, from pop bangers to Christian hymns, and thus is she one of the most influential artists of our time. This playlist tracks down some her musical roots - and follow just a couple of the many influences by her. (Photo: Rovi)"
              }
            ]
          },
